NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WEATHER_API_BASE_URL=https://quantracgialai.metrostic.com/api/v1
WEATHER_API_KEY=replace-with-local-secret
WEATHER_API_TIMEOUT_MS=5000
POSTGRES_DATA_DIR=E:/IoT-data/postgres
POSTGRES_DB=iot_dev
POSTGRES_USER=iot_app
POSTGRES_PASSWORD=replace-with-local-database-secret
DATABASE_URL=postgresql://iot_app:replace-with-local-database-secret@localhost:5432/iot_dev?schema=public
TEST_DATABASE_URL=postgresql://iot_app:replace-with-local-database-secret@localhost:5432/iot_test?schema=public
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_PEPPER=replace-with-a-different-32-character-secret
