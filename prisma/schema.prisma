generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FARMER
  CLIENT_DEVELOPER
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_PASSWORD_CHANGE
}

enum SystemAuthorityKey {
  SUPER_ADMIN
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

enum SoilAlertField {
  TEMPERATURE
  MOISTURE
  EC
  PH
  NITROGEN
  PHOSPHORUS
  POTASSIUM
  LIGHT
}

enum AlertRuleSeverity {
  WARNING
  CRITICAL
}

enum AlertEvaluationStatus {
  READY
  DISABLED
  BLOCKED_METADATA
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertResolutionReason {
  RECOVERED
  MANUAL
  RULE_DISABLED
  METADATA_CHANGED
  SOURCE_REMOVED
}

enum AlertLifecycleEventType {
  OPENED
  ACKNOWLEDGED
  RESOLVED
}

enum AlertEvaluationResult {
  BREACH
  NORMAL
  MISSING
  STALE
  INVALID
  METADATA_BLOCKED
  UPSTREAM_ERROR
}

enum IdempotencyClaimStatus {
  IN_PROGRESS
  COMPLETED
}

enum DataSourceKind {
  SYSTEM
  MANAGED
}

enum DataSourceConnectionStatus {
  CONNECTED
  FAILED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.Citext
  displayName         String     @db.VarChar(120)
  passwordHash        String     @db.Text
  role                UserRole
  status              UserStatus @default(PENDING_PASSWORD_CHANGE)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  deletionRequestedAt DateTime?  @db.Timestamptz(3)
  anonymizedAt        DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  heldAuthority       SystemAuthority?                @relation("AuthorityHolder")
  sessions            Session[]
  farmMemberships     FarmMembership[]
  clientStationGrants ClientStationGrant[]
  apiKeys             ApiKey[]
  auditEvents         SecurityAuditEvent[]            @relation("AuditActor")
  alertEvents         AlertLifecycleEvent[]           @relation("AlertEventActor")
  notifications       InAppNotification[]             @relation("NotificationRecipient")
  deliveryRecipients  NotificationDeliveryRecipient[]
  ownedDataSources    DataSource[]                    @relation("DataSourceOwner")
  dataSourceGrants    DataSourceGrant[]

  @@index([role, status])
}

model SystemAuthority {
  authority    SystemAuthorityKey @id
  holderUserId String             @unique @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  holder User @relation("AuthorityHolder", fields: [holderUserId], references: [id], onDelete: Restrict)
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique @db.VarChar(64)
  familyId            String    @db.Uuid
  expiresAt           DateTime  @db.Timestamptz(3)
  lastUsedAt          DateTime? @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  replacedBySessionId String?   @db.Uuid
  revokeReason        String?   @db.VarChar(80)
  userAgent           String?   @db.VarChar(512)
  ipAddress           String?   @db.VarChar(45)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  plots       Plot[]
  memberships FarmMembership[]
}

model Plot {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @db.Uuid
  name      String   @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  farm     Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  stations Station[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Station {
  id           String   @id @default(uuid()) @db.Uuid
  plotId       String   @db.Uuid
  dataSourceId String   @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  upstreamCode String   @db.VarChar(80)
  name         String   @db.VarChar(160)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  plot                 Plot                      @relation(fields: [plotId], references: [id], onDelete: Restrict)
  dataSource           DataSource                @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  clientGrants         ClientStationGrant[]
  apiKeyScopes         ApiKeyStationScope[]
  alertRules           AlertRule[]
  sourceGrants         DataSourceGrantStation[]
  readings             SoilReading[]
  latestReadings       SoilLatestReading[]
  historyCoverage      SoilHistoryCoverage[]
  collectionCheckpoint SoilCollectionCheckpoint?

  @@unique([dataSourceId, upstreamCode])
  @@unique([id, dataSourceId])
  @@index([plotId])
  @@index([dataSourceId])
}

model SoilReading {
  dataSourceId  String   @db.Uuid
  stationId     String   @db.Uuid
  field         String   @db.VarChar(16)
  observedAt    DateTime @db.Timestamptz(3)
  value         Float    @db.DoublePrecision
  fetchedAt     DateTime @db.Timestamptz(3)
  lastFetchedAt DateTime @db.Timestamptz(3)
  origin        String   @db.VarChar(16)
  revision      Int      @default(1)
  station       Station  @relation(fields: [stationId, dataSourceId], references: [id, dataSourceId], onDelete: Cascade)

  @@id([dataSourceId, stationId, field, observedAt])
  @@index([observedAt])
}

model SoilLatestReading {
  dataSourceId  String   @db.Uuid
  stationId     String   @db.Uuid
  field         String   @db.VarChar(16)
  observedAt    DateTime @db.Timestamptz(3)
  value         Float    @db.DoublePrecision
  fetchedAt     DateTime @db.Timestamptz(3)
  lastFetchedAt DateTime @db.Timestamptz(3)
  origin        String   @db.VarChar(16)
  revision      Int      @default(1)
  station       Station  @relation(fields: [stationId, dataSourceId], references: [id, dataSourceId], onDelete: Cascade)

  @@id([dataSourceId, stationId, field])
}

model SoilHistoryCoverage {
  dataSourceId String   @db.Uuid
  stationId    String   @db.Uuid
  field        String   @db.VarChar(16)
  begin        DateTime @db.Timestamptz(3)
  end          DateTime @db.Timestamptz(3)
  fetchedAt    DateTime @db.Timestamptz(3)
  station      Station  @relation(fields: [stationId, dataSourceId], references: [id, dataSourceId], onDelete: Cascade)

  @@id([dataSourceId, stationId, field, begin])
  @@index([end])
}

model SoilCollectionCheckpoint {
  dataSourceId   String    @db.Uuid
  stationId      String    @id @db.Uuid
  historyThrough DateTime? @db.Timestamptz(3)
  nextAttemptAt  DateTime  @default(now()) @db.Timestamptz(3)
  failureCount   Int       @default(0)
  lastResult     String    @default("pending") @db.VarChar(32)
  lastSuccessAt  DateTime? @db.Timestamptz(3)
  station        Station   @relation(fields: [stationId, dataSourceId], references: [id, dataSourceId], onDelete: Cascade)

  @@unique([stationId, dataSourceId])
  @@index([nextAttemptAt, stationId])
}

model DataSource {
  id               String                     @id @default(uuid()) @db.Uuid
  kind             DataSourceKind             @default(MANAGED)
  ownerUserId      String?                    @db.Uuid
  name             String                     @db.VarChar(160)
  baseUrl          String                     @db.VarChar(2048)
  keyCiphertext    String?                    @db.Text
  keyNonce         String?                    @db.VarChar(64)
  keyAuthTag       String?                    @db.VarChar(64)
  keyPreview       String?                    @db.VarChar(4)
  connectionStatus DataSourceConnectionStatus
  lastCheckedAt    DateTime                   @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)
  removedAt        DateTime?                  @db.Timestamptz(3)

  owner    User?             @relation("DataSourceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  stations Station[]
  grants   DataSourceGrant[]

  @@index([ownerUserId, createdAt, id])
  @@index([connectionStatus, updatedAt])
  @@index([removedAt, createdAt, id])
}

model DataSourceGrant {
  dataSourceId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  dataSource DataSource               @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stations   DataSourceGrantStation[]

  @@id([dataSourceId, userId])
  @@index([userId, createdAt])
}

model DataSourceGrantStation {
  dataSourceId String   @db.Uuid
  userId       String   @db.Uuid
  stationId    String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  grant   DataSourceGrant @relation(fields: [dataSourceId, userId], references: [dataSourceId, userId], onDelete: Cascade)
  station Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([dataSourceId, userId, stationId])
  @@index([stationId, userId])
}

model FarmMembership {
  userId    String   @db.Uuid
  farmId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@id([userId, farmId])
  @@index([farmId])
}

model ClientStationGrant {
  userId    String   @db.Uuid
  stationId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([userId, stationId])
  @@index([stationId])
}

model ApiKey {
  id                String    @id @default(uuid()) @db.Uuid
  ownerUserId       String    @db.Uuid
  name              String    @db.VarChar(120)
  prefix            String    @unique @db.VarChar(24)
  keyHash           String    @unique @db.VarChar(64)
  expiresAt         DateTime  @db.Timestamptz(3)
  requestsPerMinute Int       @default(60)
  lastUsedAt        DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  owner  User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  scopes ApiKeyStationScope[]

  @@index([ownerUserId, revokedAt])
  @@index([expiresAt])
}

model ApiKeyStationScope {
  apiKeyId  String   @db.Uuid
  stationId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, stationId])
  @@index([stationId])
}

model SecurityAuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      String      @db.VarChar(100)
  targetType  String      @db.VarChar(80)
  targetId    String?     @db.VarChar(120)
  result      AuditResult
  requestId   String      @db.VarChar(128)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

model AlertRule {
  id                      String                @id @default(uuid()) @db.Uuid
  stationId               String                @db.Uuid
  field                   SoilAlertField
  unit                    String                @db.VarChar(32)
  metadataRevision        String                @db.VarChar(160)
  condition               Json
  severity                AlertRuleSeverity
  requiredBreachSamples   Int                   @default(2)
  requiredRecoverySamples Int                   @default(2)
  isEnabled               Boolean               @default(true)
  evaluationStatus        AlertEvaluationStatus @default(READY)
  revision                Int                   @default(1)
  activeKey               String?               @unique @db.VarChar(128)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)

  station         Station               @relation(fields: [stationId], references: [id], onDelete: Restrict)
  evaluationState AlertEvaluationState?
  alerts          Alert[]

  @@index([stationId, createdAt, id])
  @@index([isEnabled, id])
}

model AlertEvaluationState {
  ruleId                   String                 @id @db.Uuid
  lastObservedAt           DateTime?              @db.Timestamptz(3)
  lastValue                Decimal?               @db.Decimal(18, 6)
  lastEvaluatedAt          DateTime?              @db.Timestamptz(3)
  lastResult               AlertEvaluationResult?
  consecutiveBreachCount   Int                    @default(0)
  consecutiveRecoveryCount Int                    @default(0)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model Alert {
  id               String                 @id @default(uuid()) @db.Uuid
  ruleId           String                 @db.Uuid
  unresolvedRuleId String?                @unique @db.Uuid
  status           AlertStatus
  openedValue      Decimal                @db.Decimal(18, 6)
  openedObservedAt DateTime               @db.Timestamptz(3)
  latestValue      Decimal                @db.Decimal(18, 6)
  latestObservedAt DateTime               @db.Timestamptz(3)
  openedAt         DateTime               @default(now()) @db.Timestamptz(3)
  acknowledgedAt   DateTime?              @db.Timestamptz(3)
  acknowledgedBy   String?                @db.Uuid
  resolvedAt       DateTime?              @db.Timestamptz(3)
  resolvedBy       String?                @db.Uuid
  resolutionReason AlertResolutionReason?
  revision         Int                    @default(1)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  rule   AlertRule             @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  events AlertLifecycleEvent[]

  @@index([ruleId, updatedAt, id])
  @@index([status, updatedAt, id])
}

model AlertLifecycleEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  alertId   String                  @db.Uuid
  type      AlertLifecycleEventType
  revision  Int
  actorId   String?                 @db.Uuid
  note      String?                 @db.VarChar(500)
  requestId String                  @db.VarChar(128)
  createdAt DateTime                @default(now()) @db.Timestamptz(3)

  alert         Alert                    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actor         User?                    @relation("AlertEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifications InAppNotification[]
  deliveryJob   NotificationDeliveryJob?

  @@unique([alertId, revision])
  @@index([createdAt])
}

model NotificationDeliveryJob {
  lifecycleEventId    String            @id @db.Uuid
  farmId              String            @db.Uuid
  stationId           String            @db.Uuid
  stationCode         String            @db.VarChar(80)
  stationName         String            @db.VarChar(160)
  field               SoilAlertField
  severity            AlertRuleSeverity
  alertStatus         AlertStatus
  cursorUserId        String?           @db.Uuid
  recipientSnapshotAt DateTime?         @db.Timestamptz(3)
  deliveredAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)

  lifecycleEvent AlertLifecycleEvent             @relation(fields: [lifecycleEventId], references: [id], onDelete: Cascade)
  recipients     NotificationDeliveryRecipient[]

  @@index([deliveredAt, createdAt, lifecycleEventId])
}

model NotificationDeliveryRecipient {
  lifecycleEventId String @db.Uuid
  recipientUserId  String @db.Uuid

  job       NotificationDeliveryJob @relation(fields: [lifecycleEventId], references: [lifecycleEventId], onDelete: Cascade)
  recipient User                    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@id([lifecycleEventId, recipientUserId])
}

model InAppNotification {
  id               String    @id @default(uuid()) @db.Uuid
  lifecycleEventId String    @db.Uuid
  recipientUserId  String    @db.Uuid
  isRead           Boolean   @default(false)
  readAt           DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  lifecycleEvent AlertLifecycleEvent @relation(fields: [lifecycleEventId], references: [id], onDelete: Cascade)
  recipient      User                @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([lifecycleEventId, recipientUserId])
  @@index([recipientUserId, createdAt, id])
}

model IdempotencyClaim {
  id                 String                 @id @default(uuid()) @db.Uuid
  operation          String                 @db.VarChar(80)
  key                String                 @db.VarChar(160)
  requestFingerprint String                 @db.VarChar(64)
  status             IdempotencyClaimStatus
  response           Json?
  expiresAt          DateTime               @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([operation, key])
  @@index([expiresAt])
}

model EvaluatorLease {
  name           String   @id @db.VarChar(80)
  holderId       String   @db.VarChar(120)
  expiresAt      DateTime @db.Timestamptz(3)
  continuationId String?  @db.Uuid
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}
