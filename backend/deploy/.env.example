# Production deployment environment template
# All values below are non-production placeholders and must be replaced before deployment.
# Do not commit real credentials or .env files to version control.

# Container images (supplied via release registry)
COMPOSE_PROFILES=maintenance
API_IMAGE=ghcr.io/example/iot-api:latest
API_TOOLS_IMAGE=ghcr.io/example/iot-api-tools:latest
WEB_IMAGE=ghcr.io/example/iot-web:latest

# PostgreSQL credentials for internal database service
POSTGRES_DB=iot_production
POSTGRES_USER=iot_app
POSTGRES_PASSWORD=replace-with-secure-database-password

# Database connection strings (internal network target: postgres:5432)
DATABASE_URL=postgresql://iot_app:replace-with-secure-database-password@postgres:5432/iot_production?schema=public
# TEST_DATABASE_URL must be isolated from DATABASE_URL even in production configuration checks
TEST_DATABASE_URL=postgresql://iot_app:replace-with-secure-database-password@postgres:5432/iot_production_test?schema=public

# Application runtime settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# External Weather API configuration (outbound egress)
WEATHER_API_BASE_URL=https://weather.example.com/api/v1
WEATHER_API_KEY=replace-with-production-weather-key
WEATHER_API_TIMEOUT_MS=5000

# Frontend origin (matches reverse proxy host / published port 8080)
WEB_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Cryptographic secrets: JWT secret and credential pepper must be distinct and >= 32 characters
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-signing
CREDENTIAL_PEPPER=replace-with-a-different-32-character-secret-for-pepper

# Data source encryption key: exactly 32 bytes base64 encoded (44 chars ending in =)
DATA_SOURCE_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLWEtMzItYnl0ZS1rZXktaGVyZSE=
# Allowed HTTPS origins for external data sources
DATA_SOURCE_ALLOWED_ORIGINS=https://datasource.example.com

# Soil observation cache and stale data thresholds
SOIL_LATEST_CACHE_TTL_MS=30000
SOIL_HISTORY_CACHE_TTL_MS=300000
SOIL_STALE_AFTER_MS=900000
SOIL_STALE_IF_ERROR_MS=300000
SOIL_CACHE_MAX_ENTRIES=500

# Background soil collection settings
SOIL_COLLECTION_ENABLED=true
SOIL_COLLECTION_INTERVAL_MS=120000
SOIL_COLLECTION_CONCURRENCY=2
SOIL_COLLECTION_BATCH_SIZE=20
SOIL_COLLECTION_PAGE_LIMIT=10
SOIL_COLLECTION_LEASE_MS=115000
SOIL_RAW_STATION_LIMIT=2000000
SOIL_RAW_GLOBAL_LIMIT=10000000

# Alert evaluation settings (lease must be strictly less than interval)
ALERT_EVALUATION_INTERVAL_MS=60000
ALERT_EVALUATION_BATCH_SIZE=50
ALERT_EVALUATOR_LEASE_MS=55000
ALERT_IDEMPOTENCY_RETENTION_HOURS=168

# Demo alert metadata is strictly forbidden in production
ALERT_DEMO_METADATA_ENABLED=false
ALERT_DEMO_STATION_CODES=
